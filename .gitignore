# Dependencies
node_modules

# Production build
/build

# Testing
/coverage

# Environment - never commit real values. .env.local variants are CRA's own
# convention for a machine-local override that should never be shared.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
bash.exe.stackdump

# ESLint's cache replays results for files whose content changed but whose
# mtime did not - a checkout, a branch switch - and has produced phantom
# warnings that failed CI builds for code that was actually clean. See
# docs/eslint-cache.md.
.eslintcache
